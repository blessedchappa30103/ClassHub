<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1787298382185-1" author="chappa">
        <createTable tableName="announcments">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_announcments"/>
            </column>
            <column name="content" type="Text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="course_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1787298382185-2" author="chappa">
        <createTable tableName="attachments">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_attachments"/>
            </column>
            <column name="original_file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="download_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="announcement_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1787298382185-3" author="chappa">
        <createTable tableName="courses">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_courses"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="join_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1787298382185-4" author="chappa">
        <createTable tableName="enrollments">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_enrollments"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="course_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1787298382185-5" author="chappa">
        <createTable tableName="users">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="surname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1787298382185-6" author="chappa">
        <addUniqueConstraint columnNames="student_id, course_id" constraintName="uc_c71a585cf98f96905b23e91cf"
                             tableName="enrollments"/>
    </changeSet>
    <changeSet id="1787298382185-7" author="chappa">
        <addUniqueConstraint columnNames="join_code" constraintName="uc_courses_join_code" tableName="courses"/>
    </changeSet>
    <changeSet id="1787298382185-8" author="chappa">
        <addUniqueConstraint columnNames="email" constraintName="uc_users_email" tableName="users"/>
    </changeSet>
    <changeSet id="1787298382185-9" author="chappa">
        <addForeignKeyConstraint baseColumnNames="course_id" baseTableName="announcments"
                                 constraintName="FK_ANNOUNCMENTS_ON_COURSE" referencedColumnNames="id"
                                 referencedTableName="courses"/>
    </changeSet>
    <changeSet id="1787298382185-10" author="chappa">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="announcments"
                                 constraintName="FK_ANNOUNCMENTS_ON_USER" referencedColumnNames="id"
                                 referencedTableName="users"/>
    </changeSet>
    <changeSet id="1787298382185-11" author="chappa">
        <addForeignKeyConstraint baseColumnNames="announcement_id" baseTableName="attachments"
                                 constraintName="FK_ATTACHMENTS_ON_ANNOUNCEMENT" referencedColumnNames="id"
                                 referencedTableName="announcments"/>
    </changeSet>
    <changeSet id="1787298382185-12" author="chappa">
        <addForeignKeyConstraint baseColumnNames="course_id" baseTableName="enrollments"
                                 constraintName="FK_ENROLLMENTS_ON_COURSE" referencedColumnNames="id"
                                 referencedTableName="courses"/>
    </changeSet>
    <changeSet id="1787298382185-13" author="chappa">
        <addForeignKeyConstraint baseColumnNames="student_id" baseTableName="enrollments"
                                 constraintName="FK_ENROLLMENTS_ON_STUDENT" referencedColumnNames="id"
                                 referencedTableName="users"/>
    </changeSet>

</databaseChangeLog>